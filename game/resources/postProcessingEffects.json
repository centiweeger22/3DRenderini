[
    {
        "name":"depthOfField",  
        "framebuffers":[
            {"name":"depthFields"},
            {"name":"nearBlur"},
            {"name":"farBlur"}
        ],
        "effects":[
            {
                "name":"drawDepthFields",
                "shader":"DOFBlendAmounts",
                "inputFramebuffers":[
                    "RENDERINI_MainFramebuffer"
                ],
                "outputFramebuffer":"depthFields"
            },
            {
                "name":"drawNearBlur",
                "shader":"DOFNearField",
                "inputFramebuffers":[
                    "RENDERINI_MainFramebuffer"
                ],
                "outputFramebuffer":"nearBlur"
            },
            {
                "name":"drawFarBlur",
                "shader":"DOFFarField",
                "inputFramebuffers":[
                    "RENDERINI_MainFramebuffer",
                    "depthFields"
                ],
                "outputFramebuffer":"farBlur"
            },
            {
                "name":"drawOutput",
                "shader":"DOFOutput",
                "inputFramebuffers":[
                    "nearBlur",
                    "farBlur",
                    "RENDERINI_MainFramebuffer",
                    "depthFields"
                ],
                "outputFramebuffer":"RENDERINI_Output"
            }
        ]
    }
]